  m_Script: {fileID: 11500000, guid: 6d760c134fc8c9744ba354a5926c9ead, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1216759681}
  typingSpeed: 0.03
  dialogos:
  - id: intro1
    texto: "\xA1HOLA! BIENVENIDO AL JUEGO. SOY AFTON. TE VOY A GUIAR PARA QUE PUEDAS
      AYUDAR A FREDDY EN SU AVENTURA."
  - id: intro2
    texto: "EMPEZAREMOS A VER PARA QU\xC9 SIRVEN LOS BOTONES."
  - id: intro3
    texto: "SI HACES CLICK AQU\xCD PODR\xC1S VER LOS OBJETIVOS DEL NIVEL PARA COMPLETAR."
  - id: intro4
    texto: "SI HACES CLICK AQU\xCD PODR\xC1S VER TUS ACIERTOS Y DESACIERTOS. SER
      AMABLE ES IMPORTANTE."
  - id: intro5
    texto: SI NECESITAS AYUDA, CONESJOS O PISTAS PUEDES HACER CLICK EN EL MINI YO.
  - id: intro6
    texto: "SI QUIERES DESCANSAR UN RATO PUEDES HACER CLICK AQUI.  DESPU\xC9S PUEDES
      CONTINUAR JUGANDO."
  - id: intro7
    texto: PUEDES MOVERTE E INTERACTUAR CON OBJETOS CON CLICK.
  - id: intro8
    texto: "\xA1ESO ES TODO! ESPERO QUE DISFRUTES DEL JUEGO."
